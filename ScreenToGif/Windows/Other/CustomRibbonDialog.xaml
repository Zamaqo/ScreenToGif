<n:ExWindow x:Class="ScreenToGif.Windows.Other.CustomRibbonDialog"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:n="clr-namespace:ScreenToGif.Controls"
            Title="{DynamicResource S.Editor.Custom.Title}" Height="520" Width="760" MinHeight="420" MinWidth="640"
            Icon="/ScreenToGif;component/Resources/Logo.ico" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">

    <n:ExWindow.CommandBindings>
        <CommandBinding Command="{StaticResource Command.Cancel}" CanExecute="Cancel_CanExecute" Executed="Cancel_Executed"/>
    </n:ExWindow.CommandBindings>

    <n:ExWindow.Resources>
        <DataTemplate x:Key="RibbonActionTemplate">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Border Width="18" Height="18" Background="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Element.Foreground}"/>
                    <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource Element.Foreground.Gray112}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </n:ExWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="12,10,12,6" TextWrapping="Wrap" Foreground="{DynamicResource Element.Foreground.Header}"
                   Text="{DynamicResource S.Editor.Custom.Instruction}"/>

        <Grid Grid.Row="1" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="{DynamicResource Element.Foreground}"
                       Text="{DynamicResource S.Editor.Custom.Selected}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="{DynamicResource Element.Foreground}"
                       Text="{DynamicResource S.Editor.Custom.Available}"/>

            <ListBox Grid.Row="1" Grid.Column="0" x:Name="SelectedList" ItemTemplate="{StaticResource RibbonActionTemplate}"
                     SelectionChanged="List_SelectionChanged" MouseDoubleClick="SelectedList_MouseDoubleClick"/>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                <n:ExtendedButton x:Name="AddButton" Text="{DynamicResource S.Add}" MinWidth="110" Margin="0,0,0,6" Padding="8,4" Click="AddButton_Click"/>
                <n:ExtendedButton x:Name="RemoveButton" Text="{DynamicResource S.Editor.Custom.Remove}" MinWidth="110" Margin="0,0,0,16" Padding="8,4" Click="RemoveButton_Click"/>
                <n:ExtendedButton x:Name="UpButton" Text="{DynamicResource S.Editor.Custom.MoveUp}" MinWidth="110" Margin="0,0,0,6" Padding="8,4" Click="UpButton_Click"/>
                <n:ExtendedButton x:Name="DownButton" Text="{DynamicResource S.Editor.Custom.MoveDown}" MinWidth="110" Padding="8,4" Click="DownButton_Click"/>
            </StackPanel>

            <ListBox Grid.Row="1" Grid.Column="2" x:Name="AvailableList" ItemTemplate="{StaticResource RibbonActionTemplate}"
                     SelectionChanged="List_SelectionChanged" MouseDoubleClick="AvailableList_MouseDoubleClick"/>
        </Grid>

        <Grid Grid.Row="2" Background="{DynamicResource Panel.Background.Level3}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <n:ExtendedButton Grid.Column="1" x:Name="OkButton" Text="{DynamicResource S.Ok}" Icon="{StaticResource Vector.Ok}"
                              ContentWidth="18" ContentHeight="18" Padding="5,0" MinWidth="90" Margin="5" Click="OkButton_Click"/>

            <n:ExtendedButton Grid.Column="2" x:Name="CancelButton" Text="{DynamicResource S.Cancel}" Icon="{StaticResource Vector.Cancel}"
                              ContentWidth="18" ContentHeight="18" Padding="5,0" MinWidth="90" Margin="5" Command="{StaticResource Command.Cancel}"/>
        </Grid>
    </Grid>
</n:ExWindow>
